{
  "name": "cnfirmed",
  "version": "0.1.0",
  "description": "Find and verify sources for Wikipedia {{citation needed}} claims using Claude.",
  "type": "module",
  "bin": {
    "cnfirmed": "./dist/cli/index.js"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": "./dist/core/index.js",
    "./core": "./dist/core/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run copy:prompts",
    "copy:prompts": "node --input-type=module -e \"import {cpSync} from 'node:fs'; cpSync('src/prompts','dist/prompts',{recursive:true})\"",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "test": "node --test --import tsx test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "eval": "tsx eval/run.ts && tsx eval/score.ts",
    "eval:run": "tsx eval/run.ts",
    "eval:score": "tsx eval/score.ts",
    "eval:record": "NODE_USE_ENV_PROXY=1 tsx eval/run.ts --record",
    "eval:sample": "NODE_USE_ENV_PROXY=1 tsx eval/sample.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "linkedom": "^0.18.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
