{
  "name": "cnfirmed",
  "version": "0.1.0",
  "description": "Find and verify sources for Wikipedia {{citation needed}} claims using Claude.",
  "type": "module",
  "bin": {
    "cnfirmed": "./dist/cli/index.js"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": "./dist/core/index.js",
    "./core": "./dist/core/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run copy:prompts",
    "copy:prompts": "node --input-type=module -e \"import {cpSync} from 'node:fs'; cpSync('src/prompts','dist/prompts',{recursive:true})\"",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "server": "tsx src/server/index.ts",
    "inline:prompts": "node scripts/inline-prompts.mjs",
    "worker:dev": "npm run inline:prompts && wrangler dev",
    "worker:deploy": "npm run inline:prompts && wrangler deploy",
    "test": "node --test --import tsx test/**/*.test.ts",
    "typecheck": "npm run inline:prompts && tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@hono/node-server": "^2.0.1",
    "commander": "^12.1.0",
    "hono": "^4.12.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260503.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.87.0"
  },
  "engines": {
    "node": ">=20"
  }
}
